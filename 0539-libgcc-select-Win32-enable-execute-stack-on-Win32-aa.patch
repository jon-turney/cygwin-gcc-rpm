From da65b27d8cc3fb9978e62e06f09ab80acf8f856e Mon Sep 17 00:00:00 2001
From: Jon Turney <jon.turney@dronecode.org.uk>
Date: Tue, 26 May 2026 17:36:25 +0100
Subject: [PATCH 1/3] libgcc: select Win32 enable-execute-stack on Win32
 aarch64, also

---
 libgcc/config.host | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libgcc/config.host b/libgcc/config.host
index 64ebcf4ecd48..ac022ffd2ae6 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -377,10 +377,10 @@ case ${host} in
   *-*-solaris2*)
   enable_execute_stack=enable-execute-stack-mprotect.c
   ;;
-i[34567]86-*-mingw* | x86_64-*-mingw*)
+i[34567]86-*-mingw* | x86_64-*-mingw* | aarch64-*-mingw*)
   enable_execute_stack=config/i386/enable-execute-stack-mingw32.c
   ;;
-i[34567]86-*-cygwin* | x86_64-*-cygwin*)
+i[34567]86-*-cygwin* | x86_64-*-cygwin* | aarch64-*-cygwin)
   enable_execute_stack=config/i386/enable-execute-stack-mingw32.c
   ;;
 *)
